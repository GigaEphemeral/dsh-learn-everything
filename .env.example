# Copy to .env and fill in real values. .env is gitignored.
# API key shown under Obsidian: Settings -> Local REST API
OBSIDIAN_API_KEY=your-api-key-here
# Base URL of the plugin's HTTPS server (default below)
OBSIDIAN_BASE_URL=https://127.0.0.1:27124
# Adapter-scoped vault directory (optional; e.g. learnEverything)
OBSIDIAN_SCOPE=
# --- karpathywiki ingest wait (tunable; environments differ) ---
# OBSIDIAN_INGEST_TIMEOUT_MS: max ms to block waiting for compiled wiki pages
#   after triggering ingest. karpathywiki compiles via an external LLM and can
#   take minutes per source; raise it on slow networks/models. Default 900000 (15 min).
# OBSIDIAN_INGEST_POLL_INTERVAL_MS: ms between checks of the wiki output folders.
#   Lower = faster detection of completion, more requests. Default 10000 (10 s).
