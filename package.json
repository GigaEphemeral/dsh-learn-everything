{
  "name": "dsh-learn-everything",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH + Obsidian 个人知识学习系统插件：连 Obsidian（受控读写/摄入/检索）+ 学习闭环（每日一练/追问）。Complete DSH plugin bundle.",
  "scripts": {
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:live": "node --test tests/integration-live.test.js",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.6"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "yaml": "^2.4.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "learning",
    "obsidian"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "skills",
    "lib",
    "src",
    "scripts",
    "tests",
    "tsconfig.json",
    "package.json",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.3"
  }
}
