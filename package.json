{
  "name": "dsh-learn-everything",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH + Obsidian \u4e2a\u4eba\u77e5\u8bc6\u5b66\u4e60\u7cfb\u7edf\u63d2\u4ef6\uff1a\u8fde Obsidian\uff08\u53d7\u63a7\u8bfb\u5199/\u6444\u5165/\u68c0\u7d22\uff09+ \u5b66\u4e60\u95ed\u73af\uff08\u6bcf\u65e5\u4e00\u7ec3/\u8ffd\u95ee\uff09\u3002Complete DSH plugin bundle.",
  "scripts": {
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:live": "node --test tests/integration-live.test.js",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "build:client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "cheerio": "^1.2.0",
    "yaml": "^2.4.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "learning",
    "obsidian"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "skills",
    "lib",
    "src",
    "scripts",
    "tests",
    "tsconfig.json",
    "package.json",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
