{
  "name": "dsh-learn-everything",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH + Obsidian 个人知识学习系统插件：连 Obsidian（受控读写/摄入/检索）+ 学习闭环（每日一练/追问）。Complete DSH plugin bundle.",
  "scripts": {
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:live": "node --test tests/integration-live.test.js",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && npm run build:client",
    "build:client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "cheerio": "^1.2.0",
    "yaml": "^2.4.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skill",
    "learning",
    "obsidian"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "skills",
    "lib",
    "src",
    "scripts",
    "panel",
    "README.md",
    "README-zh.md",
    "LICENSE",
    "!lib/tests"
  ],
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
